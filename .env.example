# ==========================================
# Ride Captain's Copilot - Environment Config
# ==========================================

# LLM Provider: 'mock' (default, works with 0 keys offline), 'gemini', or 'anthropic'
LLM_PROVIDER=mock

# Gemini API Key (Optional if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Anthropic API Key (Optional if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenRouteService API Key (Optional, uses cached route data if empty or DEMO_MODE=true)
ORS_API_KEY=

# ElevenLabs Speech (Optional, uses browser Web Speech API if empty)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Google Calendar OAuth Credentials JSON string or path (Optional, falls back to .ics export)
GOOGLE_CALENDAR_CREDENTIALS=

# Demo Mode: When true, uses deterministic mock LLM & cached high-fidelity OSM/Weather/Route data
DEMO_MODE=true

# Server Configuration
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./ride_copilot.db
